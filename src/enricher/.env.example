# --- pull target (JVN) ---
JVN_BASE_URL=http://localhost:8080
INTERNAL_API_KEY=

# --- cadence / batch ---
PULL_LIMIT=60
WRITEBACK_BATCH_SIZE=50
HTTP_TIMEOUT_SECONDS=30

# --- optional inbound edge (OFF in pull mode) ---
EDGE_ENABLED=0
EDGE_PORT=8787
# EDGE_HMAC_SECRET=
# TUNNEL_NAME=jobnorm

# --- local dashboard (127.0.0.1 only) ---
DASHBOARD_PORT=8788

# --- local open-model engines (ollama / opencode) ---
# The engine itself is a runtime knob (classify:engine / judge:engine, default
# claude-code) set via the CLI or dashboard; these are process-level infra:
OLLAMA_BASE_URL=http://localhost:11434
OPENCODE_BINARY=opencode
CLAUDE_BINARY=claude
ENGINE_TIMEOUT_SECONDS=300

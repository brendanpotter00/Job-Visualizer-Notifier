<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The enricher cutover's merge trigger. Rendered by install_watcher.sh, which
  replaces __STATE_DIR__ and __HOME__. Do not load this template directly.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bp.jvn-enricher-cutover</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__STATE_DIR__/watcher.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/jvn-enricher-cutover.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/jvn-enricher-cutover.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>

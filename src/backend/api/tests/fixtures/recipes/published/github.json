    "location": "location_name",
    "posted_at": "posted_date",
    "description": "description"
   }
  },
  {
   "op": "parse_date",
   "field": "posted_at",
   "mode": "iso"
  },
  {
   "op": "dedupe_key",
   "field": "id"
  },
  {
   "op": "assert_unique",
   "field": "id"
  },
  {
   "op": "assert_page_advances"
  }
 ],

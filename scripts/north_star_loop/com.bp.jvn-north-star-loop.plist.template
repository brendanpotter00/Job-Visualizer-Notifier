<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by scripts/north_star_loop/install_launch_agent.sh. Fires 4x/day; runs are token-free unless loop.py next names an action. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bp.jvn-north-star-loop</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/bpotter/developer/personal/Job-Visualizer-Notifier/scripts/north_star_loop/wrapper.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/bpotter/developer/personal/Job-Visualizer-Notifier</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/bpotter/Library/Logs/jvn-north-star-loop.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bpotter/Library/Logs/jvn-north-star-loop.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>

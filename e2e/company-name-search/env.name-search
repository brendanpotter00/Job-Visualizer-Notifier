# The ONLY env the name-search intent-test backend reads.
#
# run.sh exports every line here BEFORE launching stack_app.py, so these beat
# whatever the root .env.local says (pydantic-settings: env vars > .env files).
#
# NO SECRET LIVES IN THIS FILE. BROWSERBASE_API_KEY / BROWSERBASE_PROJECT_ID /
# ANTHROPIC_API_KEY are read out of the repo-root .env.local by run.sh at launch
# time and exported into the child process only.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobscraper_e2e

CUSTOM_COMPANY_SOURCES_ENABLED=true
COMPANY_NAME_SEARCH_ENABLED=true

# Discovery is not on the path this suite exercises (search-by-name writes
# nothing and starts no discovery run), and off is the cheaper default.
CUSTOM_COMPANY_DISCOVERY_ENABLED=false

# THE MONEY LINE, and it is not the same one as the add-companies gate's.
# Browserbase SEARCH is what this feature is made of and is billed per call at
# $0.007 — the suite spends it on purpose and prints the total. Browserbase
# BROWSER HOURS are the expensive thing, `search-by-name` never needs one, and
# stack_app.py refuses to boot if this is true.
CAPTURE_USE_BROWSERBASE=false

# Same fake-tenant seam as the add-companies gate — e2e/shared/auth mints against
# exactly this issuer and audience.
AUTH0_DOMAIN=e2e.local.test
AUTH0_AUDIENCE=https://job-visualizer-notifier.vercel.app/api

# The route shares /resolve's limiter (10/60s by default). This suite calls it
# once per case with no human pauses, and with --runs 3 that is well over the
# default — a 429 mid-run would look like a product failure instead of a limiter.
RESOLVE_RATE_LIMIT_MAX=1000

# Must stay UNSET, not empty: pydantic-settings reads `INTERNAL_API_KEY=` as the
# literal "", which is not None, and require_internal_key would then demand a
# header on every /api/* route and 401 the whole suite.
#INTERNAL_API_KEY=

PORT=8202
CORS_ORIGINS=http://127.0.0.1:8202

# The ONLY env the `subcategories` e2e backend reads.
#
# `stack_up.sh` exports every line here into the shell BEFORE launching
# `e2e/shared/stack/e2e_app.py` (this section reuses that entrypoint unchanged
# — it needs the same one patched seam and the same guards). pydantic-settings'
# precedence is env vars > .env/.env.local file values, so these override the
# root .env.local, in particular CAPTURE_USE_BROWSERBASE and the real
# AUTH0_DOMAIN.
#
# ITS OWN DATABASE, not `jobscraper_e2e`. This section SEEDS ROWS; the
# add-companies gate reads a 46k-job clone. Two sections writing fixtures into
# one database is the same class of bug as two runs sharing one stack — one of
# them silently changes the other's answers. `ensure_db.sh --schema-only`
# provisions this one in ~17s and ~110 MB, because the corpus is not evidence
# for anything this section asserts (see fixtures.py).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobscraper_e2e_subcategories

# THIS SECTION COSTS $0, AND THESE TWO LINES ARE WHY. e2e_app.py refuses to
# boot if either is wrong, so the assertion is at the stack, not in a test that
# might not run. Nothing here calls an LLM or opens a browser session: every
# fact under test is a property of one SQL operator over rows seed.py wrote.
CAPTURE_USE_BROWSERBASE=false
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# OFF, deliberately, and not just "not needed". This section never adds a
# company, so a flag that could start a capture has no business being on — it
# is the third lock behind the two above.
CUSTOM_COMPANY_SOURCES_ENABLED=false
CUSTOM_COMPANY_DISCOVERY_ENABLED=false

# AUTH0_DOMAIN drives BOTH the JWKS URL and the expected issuer, and
# `e2e_app.py` asserts this exact value at boot. The section's API tier is
# entirely ANONYMOUS — `/api/jobs/search`, `/api/jobs/facets` and
# `/api/jobs/settings` are all public — but the UI tier signs in, because a
# signed-out Recent page caps the list at 12 cards behind an overlay
# (`constants/ui.ts` SIGNED_OUT_JOB_LIMIT) and would truncate the fixture set.
AUTH0_DOMAIN=e2e.local.test
AUTH0_AUDIENCE=https://job-visualizer-notifier.vercel.app/api

# Must stay UNSET — not even `INTERNAL_API_KEY=`. pydantic-settings reads an
# empty assignment as the literal "", which is not None, and
# `require_internal_key` then demands a matching header on every /api/* route
# and 401s this whole suite. stack_up.sh also `unset`s it defensively.
#INTERNAL_API_KEY=

PORT=8203

# CORS: this section's frontend is :3203. Not :3201 — that is the
# add-companies/live-view stack, and the two must be able to run at once.
CORS_ORIGINS=http://127.0.0.1:3203,http://localhost:3203

# The ONLY env the `onboarding` e2e stack reads.
#
# `stack_up.sh` exports every line here into its shell (set -a) BEFORE it
# starts the backend AND the vite frontend, so these reach both processes and
# beat the root `.env.local` / `src/frontend/.env.local` file values
# (pydantic-settings and Vite both rank real env vars above env files).

# ITS OWN DATABASE. This section seeds jobs, a reveal flag and a pre-stamped
# account, and creates a fresh `users` row per case — so it may not share a
# database with any other section (e2e/README.md, "a section that SEEDS rows
# owns its own database"). Schema-only clone: the job corpus is not evidence
# for anything here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobscraper_e2e_onboarding

# $0, and these lines are why. Same three Browserbase locks as every section
# (e2e_app.py refuses to boot without the first two).
CAPTURE_USE_BROWSERBASE=false
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
CUSTOM_COMPANY_SOURCES_ENABLED=false
CUSTOM_COMPANY_DISCOVERY_ENABLED=false

# PostHog OFF on both halves. `POST /api/users/onboarding` and `GET /api/users`
# mirror `onboarding_completed` / `onboarding_skipped` / `user_signed_up` to
# PostHog when a project token is set — and the root .env.local carries the
# real one. Every case here signs up a brand-new identity, so without these
# lines each run would add a dozen fake sign-ups to the North Star funnel.
# An empty token never initialises the client (main.py: `if
# settings.posthog_project_token`); `stack_app.py` refuses to boot otherwise.
POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_KEY=

# AUTH0_DOMAIN drives BOTH the JWKS URL and the expected issuer; e2e_app.py
# asserts this exact value and serves its own key for it.
AUTH0_DOMAIN=e2e.local.test
AUTH0_AUDIENCE=https://job-visualizer-notifier.vercel.app/api

# The FRONTEND's auth switch, pinned. `useAuth` reports a signed-in user only
# when `AUTH_CONFIG.isEnabled` — i.e. VITE_AUTH0_DOMAIN and
# VITE_AUTH0_CLIENT_ID are both set — and the Google-credential provider the
# minted token rides in is not even mounted otherwise. Pinned here rather than
# borrowed from a developer's src/frontend/.env.local, so the gate means the
# same thing on every machine and never points the SPA at a real Auth0 tenant
# (no `auth0.*.is.authenticated` cookie exists in a fresh context, so the SDK
# never calls this fake domain). Google One Tap stays off (no client id).
VITE_AUTH0_DOMAIN=e2e.local.test
VITE_AUTH0_CLIENT_ID=e2e-onboarding
VITE_AUTH0_AUDIENCE=https://job-visualizer-notifier.vercel.app/api
VITE_GOOGLE_CLIENT_ID=
VITE_AUTH_BYPASS=false

# Must stay UNSET — not even `INTERNAL_API_KEY=` (see env.subcategories): an
# empty assignment makes the internal-key middleware 401 every /api/* call.
#INTERNAL_API_KEY=

PORT=8205

# This section's frontend is :3205 — never another section's.
CORS_ORIGINS=http://127.0.0.1:3205,http://localhost:3205

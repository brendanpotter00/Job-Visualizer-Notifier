# The billing e2e backend's env (stack_up.sh exports it). No Stripe secret
# lives here: run.sh exports the key, webhook secret and price.

# Its own database: every case writes users, subscriptions and webhook rows.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobscraper_e2e_billing

# Stripe returns the browser here: this section's frontend, not the owner's :3000.
PUBLIC_APP_URL=http://127.0.0.1:3204

# Pinned so a local src/frontend/.env.local cannot change what the UI tier renders.
VITE_ACCOUNT_PLAN_CARD_ENABLED=false

# $0 Browserbase, same three locks as every other section.
CAPTURE_USE_BROWSERBASE=false
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
CUSTOM_COMPANY_SOURCES_ENABLED=false
CUSTOM_COMPANY_DISCOVERY_ENABLED=false

# Minted tokens (shared/auth/mint.py) carry this issuer; e2e_app.py asserts it.
AUTH0_DOMAIN=e2e.local.test
AUTH0_AUDIENCE=https://job-visualizer-notifier.vercel.app/api

# Must stay UNSET (see env.subcategories): an empty INTERNAL_API_KEY= would
# make the internal-key middleware 401 every /api/* call.
#INTERNAL_API_KEY=

PORT=8204
CORS_ORIGINS=http://127.0.0.1:3204,http://localhost:3204

# The ONLY env the e2e backend reads (env.e2e — PLAN.md §2).
#
# stack_up.sh exports every line here into the shell BEFORE launching
# e2e_app.py. pydantic-settings' precedence is env vars > .env / .env.local
# file values, so these override whatever the root .env.local has (in
# particular CAPTURE_USE_BROWSERBASE=true and the real AUTH0_DOMAIN) — see
# PLAN.md §2's "two traps" and Settings.model_config in api/config.py.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobscraper_e2e

CUSTOM_COMPANY_SOURCES_ENABLED=true
CUSTOM_COMPANY_DISCOVERY_ENABLED=true

# The money line (PLAN.md §2, §7): local Chromium is $0 and proven; Browserbase
# bills per browser-hour. Both this AND a blank API key below must hold — the
# suite asserts both before any capture runs.
CAPTURE_USE_BROWSERBASE=false
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# AUTH0_DOMAIN drives BOTH the JWKS URL and the expected issuer (PLAN.md §4).
# e2e_app.py patches api.auth.jwt._get_jwks_client to serve our own keypair's
# public key at this "domain" for any token whose iss matches it.
AUTH0_DOMAIN=e2e.local.test
AUTH0_AUDIENCE=https://job-visualizer-notifier.vercel.app/api

# GOOGLE_CLIENT_ID intentionally unset: every minted token routes through the
# Auth0 branch of validate_token (never a Google-shaped iss) — see PLAN.md §4,
# "Do not use the Google issuer."

# Default is 10/60s and would bite the UI tier, which calls POST
# /api/companies/resolve on every submit (PLAN.md §5 rate-limit note).
RESOLVE_RATE_LIMIT_MAX=100

# Must stay UNSET (not even set to an empty string — pydantic-settings reads
# `INTERNAL_API_KEY=` as the literal value "", which is truthy-not-None and
# makes require_internal_key demand a matching header on every /api/* route,
# 401ing this whole suite. Genuinely absent from the environment is what
# settings.internal_api_key: str | None = None needs. stack_up.sh also
# `unset`s it defensively in case the calling shell exported one.
#INTERNAL_API_KEY=

PORT=8201

# CORS: the e2e frontend runs on :3201, not the app's usual :3000/:5173/:8000.
CORS_ORIGINS=http://127.0.0.1:3201,http://localhost:3201

# ANTHROPIC_API_KEY is deliberately NOT set here — stack_up.sh inherits it from
# the calling shell / root .env.local so the real key never lives in a file
# under e2e/. AC-04/05/06 need it; AC-09/10/11/12 and the hermetic API cases
# do not.

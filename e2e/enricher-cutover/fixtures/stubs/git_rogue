#!/usr/bin/env python3
"""CO-16's rogue writer, used as CUTOVER_GIT_BIN. Every call is the real git
(``$FAKE_REAL_GIT``), except the FIRST untracked scan of the old prod — phase
C's ``git status --ignored`` right before the online backup. That call first
starts a detached writer that keeps inserting rows into the old prod's DB for
``$FAKE_ROGUE_S`` seconds (a process ignoring the tick lock, e.g. a CLI run by
hand), waits until its first row is committed, and only then runs git. So the
backup copies a database that is still moving, and the copy's row counts lag
the source's: the check that must refuse the copy.
"""

import os
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

REAL_GIT = os.environ["FAKE_REAL_GIT"]
argv = sys.argv[1:]

if argv and argv[0] == "__writer":
    db, started, seconds = argv[1], Path(argv[2]), float(argv[3])
    conn = sqlite3.connect(db, timeout=30)
    end = time.time() + seconds
    n = 0
    while time.time() < end:
        conn.execute("INSERT INTO enrichments (job_id, category, sent) VALUES (?, 'rogue', 0)",
                     (f"rogue-{n}",))
        conn.commit()
        n += 1
        if n == 1:
            started.write_text("writing\n")
    conn.close()
    sys.exit(0)

old = os.environ["FAKE_OLD_PROD"]
marker = Path(os.environ["FAKE_LAUNCHD_DIR"]) / "rogue-started"
if ("status" in argv and "--ignored" in argv and len(argv) > 1 and argv[0] == "-C"
        and os.path.realpath(argv[1]) == os.path.realpath(old) and not marker.exists()):
    marker.write_text("starting\n")
    subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), "__writer",
                      str(Path(old) / "data" / "enricher.db"), str(marker),
                      os.environ.get("FAKE_ROGUE_S", "8")],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    deadline = time.time() + 20
    while marker.read_text() != "writing\n" and time.time() < deadline:
        time.sleep(0.01)

os.execv(REAL_GIT, [REAL_GIT, *argv])

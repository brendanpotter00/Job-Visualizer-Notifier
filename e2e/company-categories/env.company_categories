# The ONLY env the `company-categories` e2e stack reads.
#
# `stack_up.sh` exports every line here (set -a) before it starts the backend
# and the vite frontend, so these beat the root `.env.local` and
# `src/frontend/.env.local` (real env vars outrank env files in both).

# ITS OWN DATABASE: this section seeds jobs and saves a reader's filters, so it
# may not share one with any other section. Schema-only clone; the backend seeds
# the company-category tables itself on boot, from the committed JSON.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobscraper_e2e_company_categories

# $0, and these lines are why (e2e_app.py refuses to boot without the first two).
CAPTURE_USE_BROWSERBASE=false
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
CUSTOM_COMPANY_SOURCES_ENABLED=false
CUSTOM_COMPANY_DISCOVERY_ENABLED=false

# PostHog OFF on both halves: the UI tier signs a reader in, and with the root
# .env.local's real token the backend would mirror a `user_signed_up`.
POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_KEY=

AUTH0_DOMAIN=e2e.local.test
AUTH0_AUDIENCE=https://job-visualizer-notifier.vercel.app/api

# The SPA's auth switch, pinned (see env.onboarding): a worktree has no
# src/frontend/.env.local, and borrowing a developer's would make the gate mean
# different things on different machines. Google One Tap stays off.
VITE_AUTH0_DOMAIN=e2e.local.test
VITE_AUTH0_CLIENT_ID=e2e-company-categories
VITE_AUTH0_AUDIENCE=https://job-visualizer-notifier.vercel.app/api
VITE_GOOGLE_CLIENT_ID=
VITE_AUTH_BYPASS=false

# Must stay UNSET (see env.subcategories).
#INTERNAL_API_KEY=

PORT=8208

CORS_ORIGINS=http://127.0.0.1:3208,http://localhost:3208

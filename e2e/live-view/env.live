# The ONE mode in this repo that deliberately bills a Browserbase BROWSER SESSION.
#
# `e2e/README.md`'s non-negotiable is "no section may ever bill a browser hour", and
# every other section keeps it. This one is the exception, and the exception is the
# point: a live view only exists on a Browserbase capture, so a gate that refuses to
# open one can prove the frame's plumbing but can never prove the thing the owner is
# actually looking at. It is therefore OPT-IN ONLY (`e2e/run.sh live-view --live`),
# never part of the default run, and it opens exactly one session per run.
#
# What that session costs: Browserbase bills per browser-MINUTE with a one-minute
# minimum, so a ~31s discovery is one billed minute — $0.002 at the Developer tier's
# $0.12/hr overage. The Anthropic selection round is the larger line and is still
# fractions of a cent.
#
# Everything else is env.e2e, unchanged. Kept as a separate file rather than as
# overrides so that reading THIS file tells you the whole configuration of the run
# that spends money.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobscraper_e2e

CUSTOM_COMPANY_SOURCES_ENABLED=true
CUSTOM_COMPANY_DISCOVERY_ENABLED=true

# THE LINE THAT SPENDS. run.sh reads BROWSERBASE_API_KEY / BROWSERBASE_PROJECT_ID out
# of the repo-root .env.local and exports them — no secret lives under e2e/.
CAPTURE_USE_BROWSERBASE=true

AUTH0_DOMAIN=e2e.local.test
AUTH0_AUDIENCE=https://job-visualizer-notifier.vercel.app/api

RESOLVE_RATE_LIMIT_MAX=100
USER_COMPANY_ADD_RATE_LIMIT_MAX=100
CUSTOM_COMPANY_MONTHLY_ADD_LIMIT=100000

PORT=8201
CORS_ORIGINS=http://127.0.0.1:3201,http://localhost:3201

# The ONLY env the `enricher` e2e backend reads.
#
# `stack_up.sh` exports every line here into the shell BEFORE launching
# `e2e/shared/stack/e2e_app.py` (reused unchanged: same JWKS seam, same boot
# guards). pydantic-settings' precedence is env vars > .env/.env.local file
# values, so these override the root .env.local.
#
# ITS OWN DATABASE. This section SEEDS rows and the enricher CLAIMS them, which
# writes enrichment_status on job_listings; sharing a database with another
# section would let one change the other's answers. Schema-only: the enricher
# only ever sees the rows seed.py wrote.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobscraper_e2e_enricher

# THE FEATURE UNDER TEST. /pending hands out nothing with this off (EN-08 runs a
# second backend on :8206 with it flipped to false to prove exactly that).
ENRICHMENT_USE_EXTERNAL=true
# Default 10% custom share; the fixture company is a PUBLISHED source
# (`e2e_enricher`, not `custom:*`), so every row goes through the published
# slice — the slice prod's backlog drains through.

# The shared secret JVN's internal-key middleware checks and the enricher's
# JVNClient presents. A TEST VALUE, committed on purpose, used nowhere else.
# stack_up.sh `unset`s INTERNAL_API_KEY after sourcing this file (its shipped
# behaviour); `run.sh` re-arms it through E2E_INTERNAL_API_KEY, read from THIS
# line, and `sandbox.py` writes the same value into the sandbox's .env.local.
# This is the first e2e section whose backend runs with the middleware ARMED,
# so every /api/* call a case makes carries X-Internal-Key.
INTERNAL_API_KEY=e2e-enricher-not-a-secret

# $0, AND THESE LINES ARE WHY. e2e_app.py refuses to boot if either is wrong.
CAPTURE_USE_BROWSERBASE=false
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
CUSTOM_COMPANY_SOURCES_ENABLED=false
CUSTOM_COMPANY_DISCOVERY_ENABLED=false
# (ANTHROPIC_API_KEY is blanked by run.sh via E2E_BLANK_ANTHROPIC_KEY=1, not
# here: stack_up.sh treats an empty value in this file as "inherit".)

# e2e_app.py asserts this exact value at boot. Nothing in this section signs in.
AUTH0_DOMAIN=e2e.local.test
AUTH0_AUDIENCE=https://job-visualizer-notifier.vercel.app/api

PORT=8207

# No frontend in this section (E2E_SKIP_FRONTEND=1); CORS stays narrow anyway.
CORS_ORIGINS=http://127.0.0.1:3207,http://localhost:3207
